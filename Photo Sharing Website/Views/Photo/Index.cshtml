

@model IEnumerable<Photo_Sharing_Website.Models.Photo>

@{
    ViewBag.Title = "Photo Share";
}

<h2>Photo Share</h2>

@if (!Model.Any())
{
    <p>Chưa có ảnh nào. Hãy quay lại sau nhé!</p>
}
else
{
    foreach (var photo in Model)
    {
        <div style="margin-bottom: 25px;">
            <img src="@Url.Content("~/" + photo.ImagePath)"
                 alt="Photo"
                 style="max-width: 400px; height: auto;" />

            <p>@photo.Caption</p>
        </div>
    }
}
