@{
    ViewBag.Title = "My Profile";
}

<div class="profile-page">

    <!-- LEFT: PROFILE CARD -->
    <aside class="profile-card">

        <div class="profile-cover">
            <span>MY SPACE</span>
        </div>

        <div class="profile-card-content">

            <img class="profile-avatar"
                 src="https://i.pravatar.cc/200?img=11"
                 alt="Profile Avatar" />

            <h1 class="profile-username">your_username</h1>

            <p class="profile-handle">@@your_username</p>

            <p class="profile-bio">
                Capturing little moments of life.
                Finding beauty in ordinary things. 🌿
            </p>

            <!-- PROFILE STATISTICS -->
            <div class="profile-stats">

                <div class="profile-stat">
                    <strong>12</strong>
                    <span>Posts</span>
                </div>

                <div class="profile-stat">
                    <strong>350</strong>
                    <span>Followers</span>
                </div>

                <div class="profile-stat">
                    <strong>180</strong>
                    <span>Following</span>
                </div>

            </div>

            <!-- PROFILE BUTTONS -->
            <div class="profile-buttons">

                <button class="profile-edit-btn" type="button">
                    Edit Profile
                </button>

                <button class="profile-share-btn" type="button">
                    Share Profile
                </button>

            </div>

            <div class="profile-card-footer">
                <span>🌱</span>
                <p>Capture moments, naturally.</p>
            </div>

        </div>

    </aside>


    <!-- RIGHT: MY GALLERY -->
    <main class="profile-gallery">

        <div class="gallery-heading">

            <div>
                <span class="section-eyebrow">YOUR PERSONAL COLLECTION</span>
                <h2>My Gallery</h2>
                <p>All the moments you've captured.</p>
            </div>

            <span class="gallery-post-count">12 POSTS</span>

        </div>


        <!-- GALLERY GRID -->
        <div class="gallery-grid">

            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=600"
                     alt="Sunrise landscape" />
                <div class="gallery-overlay">
                    <span>♡ 128</span>
                    <span>♧ 18</span>
                </div>
            </div>

            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600"
                     alt="Green forest" />
                <div class="gallery-overlay">
                    <span>♡ 96</span>
                    <span>♧ 12</span>
                </div>
            </div>

            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=600"
                     alt="Mountain lake" />
                <div class="gallery-overlay">
                    <span>♡ 214</span>
                    <span>♧ 24</span>
                </div>
            </div>

            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=600"
                     alt="Nature landscape" />
                <div class="gallery-overlay">
                    <span>♡ 87</span>
                    <span>♧ 9</span>
                </div>
            </div>

            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=600"
                     alt="Mountain scenery" />
                <div class="gallery-overlay">
                    <span>♡ 156</span>
                    <span>♧ 21</span>
                </div>
            </div>

            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1472396961693-142e6e269027?w=600"
                     alt="Wildlife and nature" />
                <div class="gallery-overlay">
                    <span>♡ 73</span>
                    <span>♧ 8</span>
                </div>
            </div>

        </div>

    </main>

</div>