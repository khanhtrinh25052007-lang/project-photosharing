
@{
    ViewBag.Title = "Bảng tin";
}

<div class="feed-container">

    <!-- MAIN FEED -->
    <main class="feed-main">

        <!-- PAGE HEADING -->
        <div class="feed-heading">
            <span class="section-eyebrow">WELCOME TO PHOTOSHARE</span>
            <h1>Explore your world 🌿</h1>
            <p>Khám phá những khoảnh khắc tuyệt vời từ cộng đồng.</p>
        </div>


        <!-- MOMENTS SECTION -->
        <section class="moments-section">

            <div class="moments-heading">
                <div>
                    <span class="section-eyebrow">SHARE YOUR WORLD</span>
                    <h2>Moments</h2>
                    <p>Những khoảnh khắc nhỏ, những câu chuyện riêng.</p>
                </div>

                <a href="#" class="moments-view-all">Explore more →</a>
            </div>

            <div class="moments-list">

                <div class="moment-card moment-create">
                    <div class="moment-create-icon">+</div>
                    <div class="moment-card-info">
                        <strong>Share a moment</strong>
                        <span>Chia sẻ khoảnh khắc của bạn</span>
                    </div>
                </div>

                <div class="moment-card">
                    <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=500"
                         alt="Forest">

                    <div class="moment-overlay"></div>

                    <div class="moment-card-info">
                        <strong>minhanh</strong>
                        <span>Into the forest</span>
                    </div>
                </div>

                <div class="moment-card">
                    <img src="https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=500"
                         alt="Sunrise">

                    <div class="moment-overlay"></div>

                    <div class="moment-card-info">
                        <strong>hoangnam</strong>
                        <span>Morning light</span>
                    </div>
                </div>

                <div class="moment-card">
                    <img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=500"
                         alt="Mountain lake">

                    <div class="moment-overlay"></div>

                    <div class="moment-card-info">
                        <strong>thuha</strong>
                        <span>Peaceful place</span>
                    </div>
                </div>

                <div class="moment-card">
                    <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=500"
                         alt="Nature">

                    <div class="moment-overlay"></div>

                    <div class="moment-card-info">
                        <strong>tuan.ng</strong>
                        <span>Weekend escape</span>
                    </div>
                </div>

            </div>

        </section>


        <!-- FEED HEADER -->
        <section class="feed-posts-section">

            <div class="feed-section-heading">
                <div>
                    <span class="section-eyebrow">COMMUNITY STORIES</span>
                    <h2>Latest posts</h2>
                </div>

                <div class="feed-filter">
                    <button class="filter-button active">For you</button>
                    <button class="filter-button">Following</button>
                </div>
            </div>


            <!-- POST 1 -->
            <article class="post-card">

                <div class="post-header">

                    <div class="post-user">
                        <img class="post-avatar"
                             src="https://i.pravatar.cc/100?img=12"
                             alt="Minh Anh">

                        <div class="post-user-info">
                            <span class="post-username">minhanh</span>
                            <span class="post-location">Da Lat, Viet Nam</span>
                        </div>
                    </div>

                    <button class="post-more" type="button">···</button>

                </div>

                <img class="post-image"
                     src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=1000"
                     alt="A beautiful green forest">

                <div class="post-content">

                    <div class="post-actions">
                        <button class="post-action" type="button">♡</button>
                        <button class="post-action" type="button">▢</button>
                        <button class="post-action" type="button">➤</button>
                    </div>

                    <p class="post-likes">128 likes</p>

                    <p class="post-caption">
                        <strong>minhanh</strong>
                        Một buổi sáng bình yên giữa rừng xanh.
                        Đôi khi chỉ cần rời xa thành phố một chút
                        là đủ để tìm lại năng lượng.
                    </p>

                    <span class="post-comments">
                        View all 18 comments
                    </span>

                    <span class="post-time">2 HOURS AGO</span>

                </div>

            </article>


            <!-- POST 2 -->
            <article class="post-card">

                <div class="post-header">

                    <div class="post-user">
                        <img class="post-avatar"
                             src="https://i.pravatar.cc/100?img=33"
                             alt="Hoang Nam">

                        <div class="post-user-info">
                            <span class="post-username">hoangnam</span>
                            <span class="post-location">Ta Xua, Viet Nam</span>
                        </div>
                    </div>

                    <button class="post-more" type="button">···</button>

                </div>

                <img class="post-image"
                     src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=1000"
                     alt="Mountain lake">

                <div class="post-content">

                    <div class="post-actions">
                        <button class="post-action" type="button">♡</button>
                        <button class="post-action" type="button">▢</button>
                        <button class="post-action" type="button">➤</button>
                    </div>

                    <p class="post-likes">96 likes</p>

                    <p class="post-caption">
                        <strong>hoangnam</strong>
                        Chuyến đi cuối tuần và một khung cảnh
                        không thể tuyệt vời hơn. Thiên nhiên
                        luôn có cách khiến chúng ta bất ngờ.
                    </p>

                    <span class="post-comments">
                        View all 12 comments
                    </span>

                    <span class="post-time">5 HOURS AGO</span>

                </div>

            </article>


            <!-- POST 3 -->
            <article class="post-card">

                <div class="post-header">

                    <div class="post-user">
                        <img class="post-avatar"
                             src="https://i.pravatar.cc/100?img=47"
                             alt="Thu Ha">

                        <div class="post-user-info">
                            <span class="post-username">thuha</span>
                            <span class="post-location">Ninh Binh, Viet Nam</span>
                        </div>
                    </div>

                    <button class="post-more" type="button">···</button>

                </div>

                <img class="post-image"
                     src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=1000"
                     alt="Beautiful nature landscape">

                <div class="post-content">

                    <div class="post-actions">
                        <button class="post-action" type="button">♡</button>
                        <button class="post-action" type="button">▢</button>
                        <button class="post-action" type="button">➤</button>
                    </div>

                    <p class="post-likes">214 likes</p>

                    <p class="post-caption">
                        <strong>thuha</strong>
                        Lưu lại một chút bình yên của ngày hôm nay.
                        Những điều giản dị đôi khi lại đáng nhớ nhất.
                    </p>

                    <span class="post-comments">
                        View all 24 comments
                    </span>

                    <span class="post-time">1 DAY AGO</span>

                </div>

            </article>

        </section>

    </main>


    <!-- RIGHT PANEL -->
    <aside class="feed-sidebar">

        <!-- CURRENT USER -->
        <div class="current-user">

            <img class="current-user-avatar"
                 src="https://i.pravatar.cc/100?img=11"
                 alt="Your avatar">

            <div class="current-user-info">
                <strong>your_username</strong>
                <span>Your personal gallery</span>
            </div>

        </div>


        <!-- SUGGESTIONS -->
        <div class="suggestions-header">
            <h3>People to discover</h3>
            <a href="#">See all</a>
        </div>


        <div class="suggestion-item">

            <div class="suggestion-user">
                <img class="suggestion-avatar"
                     src="https://i.pravatar.cc/100?img=25"
                     alt="Ngoc Anh">

                <div class="suggestion-info">
                    <strong>ngocanh</strong>
                    <span>Nature lover</span>
                </div>
            </div>

            <button class="suggestion-follow" type="button">
                Follow
            </button>

        </div>


        <div class="suggestion-item">

            <div class="suggestion-user">
                <img class="suggestion-avatar"
                     src="https://i.pravatar.cc/100?img=52"
                     alt="Quang Minh">

                <div class="suggestion-info">
                    <strong>quangminh</strong>
                    <span>Travel photographer</span>
                </div>
            </div>

            <button class="suggestion-follow" type="button">
                Follow
            </button>

        </div>


        <div class="suggestion-item">

            <div class="suggestion-user">
                <img class="suggestion-avatar"
                     src="https://i.pravatar.cc/100?img=60"
                     alt="Linh">

                <div class="suggestion-info">
                    <strong>linh.nguyen</strong>
                    <span>Creative soul</span>
                </div>
            </div>

            <button class="suggestion-follow" type="button">
                Follow
            </button>

        </div>


        <!-- FOOTER -->
        <div class="feed-sidebar-footer">
            <p>About · Community · Privacy</p>
            <p>PhotoShare © 2026</p>
            <p>Capture moments, naturally. 🌿</p>
        </div>

    </aside>

</div>
```