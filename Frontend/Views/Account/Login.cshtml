@{
    ViewBag.Title = "Login - PhotoShare";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - PhotoShare</title>

    <link href="~/Content/Site.css" rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />
</head>

<body class="auth-body">

    <div class="auth-container">

        <!-- LEFT SIDE: LOGIN FORM -->
        <section class="auth-form-section">

            <div class="auth-form-wrapper">

                <!-- SMALL BRAND -->
                <a href="@Url.Action("Index", "Home")" class="auth-small-brand">
                    <span>🌿</span>
                    PhotoShare
                </a>

                <!-- HEADING -->
                <div class="auth-heading">
                    <h1>Welcome Back!</h1>
                    <p>Sign in to continue your journey</p>
                </div>

                <!-- LOGIN FORM -->
                <form class="auth-form">

                    <div class="auth-input-group">
                        <span class="auth-input-icon">♙</span>

                        <input type="text"
                               name="username"
                               placeholder="Username or Email"
                               autocomplete="username" />
                    </div>

                    <div class="auth-input-group">
                        <span class="auth-input-icon">♙</span>

                        <input type="password"
                               name="password"
                               placeholder="Password"
                               autocomplete="current-password" />

                        <button type="button" class="password-toggle">
                            ◉
                        </button>
                    </div>

                    <!-- REMEMBER & FORGOT -->
                    <div class="auth-options">

                        <label class="remember-option">
                            <input type="checkbox" name="remember" />
                            <span>Remember me</span>
                        </label>

                        <a href="#" class="forgot-password">
                            Forgot password?
                        </a>

                    </div>

                    <!-- LOGIN BUTTON -->
                    <button type="button" class="auth-submit-btn">
                        Sign In
                    </button>

                </form>

                <!-- DIVIDER -->
                <div class="auth-divider">
                    <span></span>
                    <p>or continue with</p>
                    <span></span>
                </div>

                <!-- SOCIAL LOGIN -->
                <div class="auth-social-buttons">

                    <button type="button" class="auth-social-btn">
                        <span class="google-icon">G</span>
                        Continue with Google
                    </button>

                    <button type="button" class="auth-social-btn">
                        <span class="facebook-icon">f</span>
                        Continue with Facebook
                    </button>

                </div>

                <!-- REGISTER LINK -->
                <div class="auth-switch">
                    <span>Don't have an account?</span>

                    <a href="@Url.Action("Register", "Account")">
                        Register now
                    </a>
                </div>

            </div>

        </section>


        <!-- RIGHT SIDE: BRANDING -->
        <section class="auth-brand-section">

            <div class="auth-leaf leaf-top"></div>
            <div class="auth-leaf leaf-bottom"></div>

            <div class="auth-brand-content">

                <div class="auth-logo">
                    <span class="auth-logo-icon">🌿</span>
                </div>

                <h2>PhotoShare</h2>

                <p>Capture · Share · Connect</p>

            </div>

        </section>

    </div>

</body>
</html>